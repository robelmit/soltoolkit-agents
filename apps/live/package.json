    "@phosphor-icons/react": "^2.1.10",
    "@soltoolkit/holder-map-react": "^0.1.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
