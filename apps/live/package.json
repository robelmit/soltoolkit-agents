{
  "name": "@soltoolkit/live",
  "version": "0.1.0",
  "private": true,
  "description": "soltoolkit Live: the toolkit working on Solana mainnet in a browser. Launches as they happen, a token checker with its safety grade, holder map and quotes, a wallet report, the trading-app checker, and the API for developers. React with shadcn/ui and Phosphor icons.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@soltoolkit/holder-map-react": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^2.1.8"
  }
