{
  "name": "@soltoolkit/live",
  "version": "0.1.0",
  "private": true,
  "description": "soltoolkit Live: the toolkit working on Solana mainnet in a browser. Launches as they happen, a token checker with its safety grade, holder map and quotes, a wallet report, the trading-app checker, and the API for developers. React with ReUI components, DM Sans and Phosphor icons.",
  "license": "MIT",
