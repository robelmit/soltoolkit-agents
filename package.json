{
  "name": "soltoolkit-agents",
  "private": true,
  "version": "0.0.0",
  "description": "A read-only MCP server and a rate-limited HTTP API for Solana launchpad tokens: quote a trade, grade a token, map its holders, name the app behind a transaction, score a wallet.",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "check": "turbo run build typecheck test && eslint .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.8"
  }
}
